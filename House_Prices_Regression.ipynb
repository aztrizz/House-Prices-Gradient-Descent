  {
   "cell_type": "code",
   "execution_count": 186,
   "id": "f70a07bc",
   "metadata": {},
   "outputs": [],
   "source": [
    "def binned_scatter(x, y, bins=20):\n",
    "    \"\"\"\n",
    "    Create a binned scatter plot using Series or array-like inputs.\n",
    "    Splits x into equal-width bins and plots mean(y) in each bin.\n",
    "    \"\"\"\n",
    "\n",
    "    # convert to numpy arrays\n",
    "    x = np.asarray(x)\n",
    "    y = np.asarray(y)\n",
    "\n",
    "    # create bins\n",
    "    bin_edges = np.linspace(x.min(), x.max(), bins + 1)\n",
    "    bin_idx = np.digitize(x, bin_edges) - 1  # bin index for each x\n",
    "\n",
    "    # compute mean y for each bin\n",
    "    bin_centers = []\n",
    "    mean_y = []\n",
    "\n",
    "    for i in range(bins):\n",
    "        in_bin = y[bin_idx == i]\n",
    "        if len(in_bin) > 0:\n",
    "            mean_y.append(in_bin.mean())\n",
    "        else:\n",
    "            mean_y.append(np.nan)\n",
    "\n",
    "        # center of the bin for plotting\n",
    "        center = (bin_edges[i] + bin_edges[i+1]) / 2\n",
    "        bin_centers.append(center)\n",
    "\n",
    "    # plot\n",
    "    plt.figure(figsize=(8, 5))\n",
    "    plt.scatter(bin_centers, mean_y)\n",
    "    plt.xlabel(\"x\")\n",
    "    plt.ylabel(\"mean(y)\")\n",
    "    plt.title(f\"Binned scatter plot ({bins} bins)\")\n",
    "    plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 187,
   "id": "bb5d00b0",
   "metadata": {},
   "outputs": [],
   "source": [
    "def hypothesis(X, theta):\n",
    "    return X.dot(theta)\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 188,
   "id": "f868aacc",
   "metadata": {},
   "outputs": [],
   "source": [
    "def compute_cost(X, y, theta):\n",
    "    m = len(y)\n",
    "    h = hypothesis(X, theta)\n",
    "    cost = (1/(2*m)) * np.sum(np.square(h - y))\n",
    "    return cost"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 189,
   "id": "a0afa57d",
   "metadata": {},
   "outputs": [],
   "source": [
    "def batch_gradient_descent(X, y, theta, learning_rate=0.01, iterations=1000):\n",
    "    m = len(y)\n",
    "    X_b = np.c_[np.ones((m, 1)), X]  \n",
    "    cost_history = np.zeros(iterations)\n",
    "\n",
    "    # m is number of example data\n",
    "    # np.c combines two different objects, in this case it attaches m rows of 1s to X\n",
    "    # initialise cost history with zeros for every iteration, will update each value at each iteration later\n",
    "    \n",
    "\n",
    "    for i in range(iterations):\n",
    "        gradients =  (1/m) * X_b.T.dot(hypothesis(X_b, theta) - y)\n",
    "        theta = theta - learning_rate * gradients\n",
    "        cost_history[i] = compute_cost(X_b, y, theta)\n",
    "\n",
    "        # gradients is differential of cost function using hypothesis with current theta at each iteration\n",
    "        # we will subtract the value above from theta at each iteration with scaled learning rate\n",
    "        \n",
    "    \n",
    "    return theta, cost_history"
   ]
  },
